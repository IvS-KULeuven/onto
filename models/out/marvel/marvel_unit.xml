              </documentation>
            </variable>
          </inOutVars>
          <localVars>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">parts.dome(
    operatorStatus := operatorStatus,
    activityStatus := activityStatus,
    config := config.dome,
    telescopeAzi := parts.telescope.actAzi);
parts.telescope(
    operatorStatus := operatorStatus,
    activityStatus := activityStatus,
    config := config.telescope);
parts.configManager( isEnabled := operatorStatus.tech );
statuses.initializationStatus();
statuses.healthStatus(
    superState := NOT(statuses.initializationStatus.shutdown),
    isGood := parts.dome.statuses.healthStatus.isGood AND (parts.telescope.statuses.healthStatus.isGood AND parts.configManager.statuses.healthStatus.isGood),
    hasWarning := parts.dome.statuses.healthStatus.hasWarning OR (parts.telescope.statuses.healthStatus.hasWarning OR parts.configManager.statuses.healthStatus.hasWarning));
statuses.busyStatus(
    superState := NOT(statuses.initializationStatus.shutdown),
    isBusy := parts.dome.statuses.busyStatus.busy OR (parts.telescope.statuses.busyStatus.busy OR parts.configManager.statuses.busyStatus.busy));
processes.initialize( isEnabled := NOT(statuses.initializationStatus.initializing) );
processes.point( isEnabled := parts.telescope.processes.slewToCoordinates.isEnabled AND parts.dome.processes.syncWithAxes.isEnabled );
processes.stop( isEnabled := parts.telescope.processes.abortSlew.isEnabled OR parts.dome.processes.stop.isEnabled );
</xhtml>
          </ST>
        </body>
