          <localVars>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">parts.dome(
    operator_ref := operator_ref,
    activity_ref := activity_ref,
    services_ref := services_ref,
    config_ref := config.dome,
    telescopeAzi_ref := parts.telescope.actAzi);
parts.telescope(
    operator_ref := operator_ref,
    activity_ref := activity_ref,
    services_ref := services_ref,
    config_ref := config.telescope);
parts.configManager( isEnabled := operator_ref = OperatorStatus.tech );
stat.health := F_HealthStatus(
    superState := NOT(stat.init = InitializationStatus.shutdown),
    isGood := (parts.dome.stat.health = HealthStatus.good) AND ((parts.telescope.stat.health = HealthStatus.good) AND (parts.configManager.stat.health = HealthStatus.good)),
    hasWarning := (parts.dome.stat.health = HealthStatus.warning) OR ((parts.telescope.stat.health = HealthStatus.warning) OR (parts.configManager.stat.health = HealthStatus.warning)));
stat.busy := F_BusyStatus(
    superState := NOT(stat.init = InitializationStatus.shutdown),
    isBusy := (parts.dome.stat.busy = BusyStatus.busy) OR ((parts.telescope.stat.busy = BusyStatus.busy) OR (parts.configManager.stat.busy = BusyStatus.busy)));
proc.initialize( isEnabled := NOT(stat.init = InitializationStatus.initializing) );
proc.point( isEnabled := parts.telescope.proc.slewToCoordinates.isEnabled AND parts.dome.proc.syncWithAxes.isEnabled );
proc.stop( isEnabled := parts.telescope.proc.abortSlew.isEnabled OR parts.dome.proc.stop.isEnabled );
</xhtml>
          </ST>
        </body>
