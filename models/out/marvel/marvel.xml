            <variable name="processes">
              <type><derived name="MarvelProcesses" /></type>
              <addData>
                <data name="http://www.3s-software.com/plcopenxml/attributes" handleUnknown="implementation">
                  <Attributes>
                  </Attributes>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Processes of the state machine</xhtml>
              </documentation>
            </variable>
          </outputVars>
          <inOutVars>
          </inOutVars>
          <localVars>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">parts.u1(
    operatorStatus := statuses.operatorStatus,
    activityStatus := statuses.activityStatus);
parts.u2(
    operatorStatus := statuses.operatorStatus,
    activityStatus := statuses.activityStatus);
parts.u3(
    operatorStatus := statuses.operatorStatus,
    activityStatus := statuses.activityStatus);
parts.u4(
    operatorStatus := statuses.operatorStatus,
    activityStatus := statuses.activityStatus);
statuses.initializationStatus();
statuses.healthStatus(
    isGood := parts.u1.statuses.healthStatus.isGood AND (parts.u2.statuses.healthStatus.isGood AND (parts.u3.statuses.healthStatus.isGood AND parts.u4.statuses.healthStatus.isGood)),
    hasWarning := parts.u1.statuses.healthStatus.hasWarning OR (parts.u2.statuses.healthStatus.hasWarning OR (parts.u3.statuses.healthStatus.hasWarning OR parts.u4.statuses.healthStatus.hasWarning)));
statuses.busyStatus( isBusy := parts.u1.statuses.busyStatus.busy OR (parts.u2.statuses.busyStatus.busy OR (parts.u3.statuses.busyStatus.busy OR parts.u4.statuses.busyStatus.busy)) );
statuses.operatorStatus();
statuses.activityStatus();
processes.initialize( isEnabled := NOT(statuses.initializationStatus.initializing) );
processes.emergencyClose( isEnabled := NOT(parts.u1.parts.dome.parts.shutter.statuses.apertureStatus.closed AND (parts.u1.parts.dome.parts.shutter.statuses.apertureStatus.closed AND (parts.u1.parts.dome.parts.shutter.statuses.apertureStatus.closed AND parts.u1.parts.dome.parts.shutter.statuses.apertureStatus.closed))) );
</xhtml>
          </ST>
        </body>
