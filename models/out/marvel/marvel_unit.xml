                    </documentation>
                  </variable>
                </localVars>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/attributes" handleUnknown="implementation">
                    <Attributes>
                    </Attributes>
                  </data>
                </addData>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">THIS^.parts.dome._log(
    name := &#39;dome&#39;,
    buffer := subBuffer);
THIS^.parts.telescope._log(
    name := &#39;telescope&#39;,
    buffer := subBuffer);
THIS^.parts.configManager._log(
    name := &#39;configManager&#39;,
    buffer := subBuffer);
THIS^.processes.initialize._log(
    name := &#39;processes.initialize&#39;,
    buffer := subBuffer);
THIS^.processes.point._log(
    name := &#39;processes.point&#39;,
    buffer := subBuffer);
THIS^.processes.stop._log(
    name := &#39;processes.stop&#39;,
    buffer := subBuffer);
LOGGER(
    name := name,
    actualStatus := THIS^.actualStatus,
    previousStatus := THIS^.previousStatus,
    buffer := buffer,
    subBuffer := subBuffer,
    pHealthStatus := ADR(THIS^.statuses.healthStatus),
    pBusyStatus := ADR(THIS^.statuses.busyStatus));
</xhtml>
                </ST>
              </body>
