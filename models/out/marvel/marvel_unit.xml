                  <Attributes>
                    <Attribute Name="TcHmiSymbol.Show" Value="" />
                    <Attribute Name="OPC.UA.DA" Value="0" />
                    <Attribute Name="TcHmiSymbol.Hide" Value="" />
                  </Attributes>
