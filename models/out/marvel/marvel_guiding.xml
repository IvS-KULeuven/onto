        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">parts.camera();
stat.health := F_HealthStatus(
    superState := TRUE,
    isGood := parts.camera.stat.health = HealthStatus.good,
    hasWarning := parts.camera.stat.health = HealthStatus.warning);
stat.busy := F_BusyStatus(
    superState := TRUE,
    isBusy := parts.camera.stat.busy = BusyStatus.busy);
proc.initialize( isEnabled := (NOT(stat.init = InitializationStatus.locked)) AND ((stat.init = InitializationStatus.shutdown) OR ((stat.init = InitializationStatus.initializingFailed) OR (stat.init = InitializationStatus.initialized))) );
proc.reset( isEnabled := TRUE );
</xhtml>
          </ST>
        </body>
