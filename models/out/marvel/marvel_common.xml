              </Inheritance>
            </data>
          </addData>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">IF do_request THEN
    do_request_result := request(
    alpha := set.alpha,
    delta := set.delta);
    do_request := FALSE;
END_IF;
SUPER^();
</xhtml>
          </ST>
