      <pou name="SM_Marvel" pouType="functionBlock">
        <interface>
          <inputVars>
          </inputVars>
          <outputVars>
            <variable name="actualStatus">
              <type><string /></type>
              <addData>
                <data name="http://www.3s-software.com/plcopenxml/attributes" handleUnknown="implementation">
